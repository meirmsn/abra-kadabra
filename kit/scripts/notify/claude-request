#!/bin/bash
# Fires when Claude Code needs user input (permission prompt or idle).
# Schedules a notification after $DELAY seconds; any activity signal cancels.
# Reads NTFY_URL from env (loaded from .devcontainer/.env).
# No-op if NTFY_URL unset. Always exits 0.
#
# Testability: CLAUDE_NOTIFY_PID_FILE + CLAUDE_NOTIFY_DELAY env vars allow
# BATS tests to override the shared /tmp path and 30s sleep.

set +e
[ -z "${NTFY_URL:-}" ] && exit 0

PID_FILE="${CLAUDE_NOTIFY_PID_FILE:-/tmp/claude-notify-pending.pid}"
DELAY="${CLAUDE_NOTIFY_DELAY:-30}"

proj=$(jq -r '.name // empty' package.json 2>/dev/null)
proj=${proj:-$(basename "$PWD")}

# Cancel any prior pending notification. Kill children first (the `sleep`
# the prior subshell spawned) so the orphaned `sleep` doesn't fire its curl
# after we've already scheduled a new one. See claude-cancel for the full
# rationale.
if [ -f "$PID_FILE" ]; then
  _prev=$(cat "$PID_FILE")
  pkill -P "$_prev" 2>/dev/null
  kill "$_prev" 2>/dev/null
fi
rm -f "$PID_FILE"

# Schedule new notification (backgrounded, detached from hook stdio)
(
  sleep "$DELAY"
  curl -sS --max-time 3 \
    -H "Title: $proj — Claude Code" \
    -H 'Priority: high' \
    -d 'Needs your input' \
    "$NTFY_URL" >/dev/null 2>&1
  rm -f "$PID_FILE"
) </dev/null >/dev/null 2>&1 &
echo "$!" > "$PID_FILE"

exit 0
