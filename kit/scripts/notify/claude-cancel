#!/bin/bash
# Cancels any pending delayed notification. Called by UserPromptSubmit +
# PreToolUse hooks — any sign of user activity means the user is present.
# Idempotent (no-op if nothing pending).

set +e
PID_FILE="${CLAUDE_NOTIFY_PID_FILE:-/tmp/claude-notify-pending.pid}"
# Kill the subshell's children (the `sleep` it spawned) BEFORE the subshell
# itself — bash doesn't propagate SIGTERM to children when the parent is
# killed, and an orphaned `sleep` survives until $DELAY elapses, racing the
# next `curl` and breaking idempotency.
if [ -f "$PID_FILE" ]; then
  _pid=$(cat "$PID_FILE")
  pkill -P "$_pid" 2>/dev/null
  kill "$_pid" 2>/dev/null
fi
rm -f "$PID_FILE"
exit 0
