diff --git a/test/starred.test.js b/test/starred.test.js
new file mode 100644
index 0000000..e1adb73
--- /dev/null
+++ b/test/starred.test.js
@@ -0,0 +1,87 @@
+// Starred items (specs/starred-items.md). Each test names the acceptance item or state it proves.
+import { env, exports } from "cloudflare:workers";
+import { describe, expect, it } from "vitest";
+
+const get = (path) => exports.default.fetch(`https://fixture.example.com${path}`);
+const star = (...ids) =>
+  env.DB.prepare(`UPDATE items SET starred = 1 WHERE id IN (${ids.map(() => "?").join(", ")})`)
+    .bind(...ids)
+    .run();
+const listed = (html) => [...html.matchAll(/<li>(.*?)<\/li>/g)].map((m) => m[1]);
+
+describe("starred items", () => {
+  it("AC-1: the migration leaves every existing item unstarred", async () => {
+    const { results } = await env.DB.prepare("SELECT starred FROM items").all();
+    expect(results.map((r) => r.starred)).toEqual([0, 0, 0]);
+    await expect(env.DB.prepare("UPDATE items SET starred = 2 WHERE id = 1").run()).rejects.toThrow();
+  });
+
+  it("AC-2: marks starred items with a star and leaves the rest unmarked", async () => {
+    await star(2);
+    const html = await (await get("/")).text();
+    expect(listed(html)).toEqual(["First item", "★ Second item", "Third item"]);
+  });
+
+  it("AC-3: the starred view lists only starred items, in id order", async () => {
+    await star(3, 1);
+    const res = await get("/?show=starred");
+    expect(res.status).toBe(200);
+    expect(listed(await res.text())).toEqual(["★ First item", "★ Third item"]);
+  });
+
+  it("AC-4: the full list is unchanged with no parameter and with show=all", async () => {
+    await star(3);
+    for (const path of ["/", "/?show=all"]) {
+      expect(listed(await (await get(path)).text())).toEqual(["First item", "Second item", "★ Third item"]);
+    }
+  });
+
+  it("AC-5: each view links to the other", async () => {
+    expect(await (await get("/")).text()).toContain('<a href="/?show=starred">Starred only</a>');
+    expect(await (await get("/?show=starred")).text()).toContain('<a href="/">All items</a>');
+  });
+
+  it("AC-6: rejects any other show value with a 400 and no list", async () => {
+    for (const value of ["Starred", "none", "", "__proto__"]) {
+      const res = await get(`/?show=${value}`);
+      expect(res.status, value).toBe(400);
+      expect(await res.text()).not.toContain("<li>");
+    }
+  });
+
+  it("AC-7: synthetic traffic requests the starred view", async () => {
+    const { default: routes } = await import("../traffic/routes.json");
+    expect(routes).toContain("/?show=starred");
+  });
+});
+
+describe("states", () => {
+  it("Full list: every item, no message, a link to the starred view", async () => {
+    const html = await (await get("/")).text();
+    expect(listed(html)).toHaveLength(3);
+    expect(html).not.toContain("No items yet.");
+    expect(html).toContain("Starred only</a>");
+  });
+
+  it("Empty table: the empty message and a link to the starred view", async () => {
+    await env.DB.prepare("DELETE FROM items").run();
+    const html = await (await get("/")).text();
+    expect(listed(html)).toEqual([]);
+    expect(html).toContain("<p>No items yet.</p>");
+    expect(html).toContain("Starred only</a>");
+  });
+
+  it("Starred view: the starred items and a link back to all items", async () => {
+    await star(2);
+    const html = await (await get("/?show=starred")).text();
+    expect(listed(html)).toEqual(["★ Second item"]);
+    expect(html).toContain("All items</a>");
+  });
+
+  it("No starred items: its own message, not the empty-table one", async () => {
+    const html = await (await get("/?show=starred")).text();
+    expect(listed(html)).toEqual([]);
+    expect(html).toContain("<p>No starred items yet.</p>");
+    expect(html).not.toContain("No items yet.");
+  });
+});
