diff --git a/test/search.test.js b/test/search.test.js
new file mode 100644
index 0000000..d0f526f
--- /dev/null
+++ b/test/search.test.js
@@ -0,0 +1,20 @@
+// Searching the list by title (?q=).
+import { exports } from "cloudflare:workers";
+import { describe, expect, it } from "vitest";
+
+const get = (path) => exports.default.fetch(`https://fixture.example.com${path}`);
+const listed = (html) => [...html.matchAll(/<li>(.*?)<\/li>/g)].map((m) => m[1]);
+
+describe("search", () => {
+  it("lists only the items whose title contains the search, ignoring case", async () => {
+    expect(listed(await (await get("/?q=SECOND")).text())).toEqual(["Second item"]);
+  });
+
+  it("keeps the search in the box, escaped", async () => {
+    expect(await (await get('/?q="><b>')).text()).toContain('value="&quot;&gt;&lt;b&gt;"');
+  });
+
+  it("lists every item with an empty search", async () => {
+    expect(listed(await (await get("/?q=")).text())).toHaveLength(3);
+  });
+});
