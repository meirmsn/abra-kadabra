diff --git a/src/index.js b/src/index.js
index f735862..ac84035 100644
--- a/src/index.js
+++ b/src/index.js
@@ -6,11 +6,12 @@ const escapeHtml = (s) =>
     (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c],
   );
 
-const page = (items) => `<!doctype html>
