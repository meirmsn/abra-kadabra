--- /dev/null
+++ b/migrations/0002_add_priority.sql
@@ -0,0 +1,2 @@
+-- Item priority (specs/item-priority.md): high, normal or low; every existing item gets normal.
+ALTER TABLE items ADD COLUMN priority TEXT NOT NULL DEFAULT 'normal' CHECK (priority IN ('high', 'normal', 'low'));
