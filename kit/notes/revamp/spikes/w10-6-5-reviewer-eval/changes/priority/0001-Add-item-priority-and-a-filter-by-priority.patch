diff --git a/test/priority.test.js b/test/priority.test.js
new file mode 100644
index 0000000..e38836e
--- /dev/null
+++ b/test/priority.test.js
@@ -0,0 +1,110 @@
+// Item priority (specs/item-priority.md). Each test names the acceptance item or state it proves.
+import { env, exports } from "cloudflare:workers";
+import { describe, expect, it } from "vitest";
+
+const get = (path) => exports.default.fetch(`https://fixture.example.com${path}`);
+const setPriority = (priority, ...ids) =>
+  env.DB.prepare(`UPDATE items SET priority = ? WHERE id IN (${ids.map(() => "?").join(", ")})`)
+    .bind(priority, ...ids)
+    .run();
+const listed = (html) => [...html.matchAll(/<li>(.*?)<\/li>/g)].map((m) => m[1]);
+const message = (html) => html.match(/<p>(.*?)<\/p>/)?.[1] ?? null;
+
+describe("item priority", () => {
+  it("AC-1: existing items get normal, and only the three priorities are accepted", async () => {
+    const { results } = await env.DB.prepare("SELECT priority FROM items").all();
+    expect(results.map((r) => r.priority)).toEqual(["normal", "normal", "normal"]);
+    await expect(setPriority("urgent", 1)).rejects.toThrow();
+  });
+
+  it("AC-2: high and low items show their priority after the title, normal ones none", async () => {
+    await setPriority("high", 1);
+    await setPriority("low", 3);
+    expect(listed(await (await get("/")).text())).toEqual([
+      "First item — high",
+      "Second item",
+      "Third item — low",
+    ]);
+  });
+
+  it("AC-3: a priority filter lists only that priority, in id order", async () => {
+    await setPriority("high", 3, 1);
+    await setPriority("low", 2);
+    expect(listed(await (await get("/?priority=high")).text())).toEqual([
+      "First item — high",
+      "Third item — high",
+    ]);
+    expect(listed(await (await get("/?priority=low")).text())).toEqual(["Second item — low"]);
+    await setPriority("normal", 1);
+    expect(listed(await (await get("/?priority=normal")).text())).toEqual(["First item"]);
+  });
+
+  it("AC-4: with no filter the list is every item in id order", async () => {
+    await setPriority("low", 1);
+    expect(listed(await (await get("/")).text())).toEqual(["First item — low", "Second item", "Third item"]);
+  });
+
+  it("AC-5: every view shows All, High, Normal and Low, the current one not a link", async () => {
+    const all = '<a href="/">All</a>';
+    const link = (p, label) => `<a href="/?priority=${p}">${label}</a>`;
+    const want = {
+      "/": `<strong>All</strong> · ${link("high", "High")} · ${link("normal", "Normal")} · ${link("low", "Low")}`,
+      "/?priority=high": `${all} · <strong>High</strong> · ${link("normal", "Normal")} · ${link("low", "Low")}`,
+      "/?priority=normal": `${all} · ${link("high", "High")} · <strong>Normal</strong> · ${link("low", "Low")}`,
+      "/?priority=low": `${all} · ${link("high", "High")} · ${link("normal", "Normal")} · <strong>Low</strong>`,
+    };
+    for (const [path, nav] of Object.entries(want)) {
+      expect(await (await get(path)).text(), path).toContain(`<nav>${nav}</nav>`);
+    }
+  });
+
+  it("AC-6: rejects any other priority value with a 400 and no list", async () => {
+    for (const value of ["High", "urgent", "", "__proto__"]) {
+      const res = await get(`/?priority=${value}`);
+      expect(res.status, value).toBe(400);
+      expect(await res.text()).not.toContain("<li>");
+    }
+  });
+
+  it("AC-7: an unmatched filter names its priority; an empty table says No items yet.", async () => {
+    expect(message(await (await get("/?priority=high")).text())).toBe("No high-priority items.");
+    expect(message(await (await get("/?priority=low")).text())).toBe("No low-priority items.");
+    await setPriority("high", 1, 2, 3);
+    expect(message(await (await get("/?priority=normal")).text())).toBe("No normal-priority items.");
+    await env.DB.prepare("DELETE FROM items").run();
+    for (const path of ["/", "/?priority=high", "/?priority=normal", "/?priority=low"]) {
+      expect(message(await (await get(path)).text()), path).toBe("No items yet.");
+    }
+  });
+
+  it("AC-8: synthetic traffic requests the high-priority filter", async () => {
+    const { default: routes } = await import("../traffic/routes.json");
+    expect(routes).toContain("/?priority=high");
+  });
+});
+
+describe("states", () => {
+  it("All priorities: every item, All current", async () => {
+    const html = await (await get("/")).text();
+    expect(listed(html)).toHaveLength(3);
+    expect(html).toContain("<strong>All</strong>");
+  });
+
+  it("One priority: only that priority's items, its filter current", async () => {
+    await setPriority("low", 2);
+    const html = await (await get("/?priority=low")).text();
+    expect(listed(html)).toEqual(["Second item — low"]);
+    expect(html).toContain("<strong>Low</strong>");
+  });
+
+  it("No match: nothing listed and the filter's own message", async () => {
+    const html = await (await get("/?priority=low")).text();
+    expect(listed(html)).toEqual([]);
+    expect(message(html)).toBe("No low-priority items.");
+  });
+
+  it("Empty table: No items yet. with no filter", async () => {
+    await env.DB.prepare("DELETE FROM items").run();
+    expect(message(await (await get("/")).text())).toBe("No items yet.");
+  });
+});
