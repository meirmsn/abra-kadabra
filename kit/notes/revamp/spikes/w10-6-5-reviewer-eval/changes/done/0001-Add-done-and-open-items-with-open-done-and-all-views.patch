diff --git a/test/done.test.js b/test/done.test.js
new file mode 100644
index 0000000..fc73aa8
--- /dev/null
+++ b/test/done.test.js
@@ -0,0 +1,119 @@
+// Done and open items (specs/done-items.md). Each test names the acceptance item or state it proves.
+import { env, exports } from "cloudflare:workers";
+import { describe, expect, it } from "vitest";
+
+const get = (path) => exports.default.fetch(`https://fixture.example.com${path}`);
+const markDone = (...ids) =>
+  env.DB.prepare(`UPDATE items SET done = 1 WHERE id IN (${ids.map(() => "?").join(", ")})`)
+    .bind(...ids)
+    .run();
+const listed = (html) => [...html.matchAll(/<li>(.*?)<\/li>/g)].map((m) => m[1]);
+const message = (html) => html.match(/<p>(.*?)<\/p>/)?.[1] ?? null;
+
+describe("done and open items", () => {
+  it("AC-1: the migration leaves every existing item open", async () => {
+    const { results } = await env.DB.prepare("SELECT done FROM items").all();
+    expect(results.map((r) => r.done)).toEqual([0, 0, 0]);
+    await expect(env.DB.prepare("UPDATE items SET done = 2 WHERE id = 1").run()).rejects.toThrow();
+  });
+
+  it("AC-2: the list opens on the open items, also with view=open", async () => {
+    await markDone(2);
+    for (const path of ["/", "/?view=open"]) {
+      expect(listed(await (await get(path)).text()), path).toEqual(["First item", "Third item"]);
+    }
+  });
+
+  it("AC-3: the done view lists only done items, marked, in id order", async () => {
+    await markDone(3, 1);
+    const res = await get("/?view=done");
+    expect(res.status).toBe(200);
+    expect(listed(await res.text())).toEqual(["✓ First item", "✓ Third item"]);
+  });
+
+  it("AC-4: the all view lists every item in id order, done ones marked", async () => {
+    await markDone(2);
+    expect(listed(await (await get("/?view=all")).text())).toEqual([
+      "First item",
+      "✓ Second item",
+      "Third item",
+    ]);
+  });
+
+  it("AC-5: every view shows Open, Done and All, the current one not a link", async () => {
+    const want = {
+      open: '<strong>Open</strong> · <a href="/?view=done">Done</a> · <a href="/?view=all">All</a>',
+      done: '<a href="/?view=open">Open</a> · <strong>Done</strong> · <a href="/?view=all">All</a>',
+      all: '<a href="/?view=open">Open</a> · <a href="/?view=done">Done</a> · <strong>All</strong>',
+    };
+    for (const [view, nav] of Object.entries(want)) {
+      expect(await (await get(`/?view=${view}`)).text(), view).toContain(`<nav>${nav}</nav>`);
+    }
+    expect(await (await get("/")).text()).toContain(`<nav>${want.open}</nav>`);
+  });
+
+  it("AC-6: rejects any other view value with a 400 and no list", async () => {
+    for (const value of ["Open", "closed", "", "__proto__"]) {
+      const res = await get(`/?view=${value}`);
+      expect(res.status, value).toBe(400);
+      expect(await res.text()).not.toContain("<li>");
+    }
+  });
+
+  it("AC-7: an empty table says so in every view; an empty view has its own message", async () => {
+    await markDone(1, 2, 3);
+    expect(message(await (await get("/?view=open")).text())).toBe("Nothing open.");
+    await env.DB.prepare("UPDATE items SET done = 0").run();
+    expect(message(await (await get("/?view=done")).text())).toBe("Nothing done yet.");
+    await env.DB.prepare("DELETE FROM items").run();
+    for (const view of ["open", "done", "all"]) {
+      expect(message(await (await get(`/?view=${view}`)).text()), view).toBe("No items yet.");
+    }
+  });
+
+  it("AC-8: synthetic traffic requests the done and all views", async () => {
+    const { default: routes } = await import("../traffic/routes.json");
+    expect(routes).toEqual(expect.arrayContaining(["/?view=done", "/?view=all"]));
+  });
+});
+
+describe("states", () => {
+  it("Open view: open items, no message, Open current", async () => {
+    await markDone(1);
+    const html = await (await get("/")).text();
+    expect(listed(html)).toEqual(["Second item", "Third item"]);
+    expect(message(html)).toBe(null);
+    expect(html).toContain("<strong>Open</strong>");
+  });
+
+  it("Done view: done items marked, Done current", async () => {
+    await markDone(2);
+    const html = await (await get("/?view=done")).text();
+    expect(listed(html)).toEqual(["✓ Second item"]);
+    expect(html).toContain("<strong>Done</strong>");
+  });
+
+  it("All view: every item, All current", async () => {
+    const html = await (await get("/?view=all")).text();
+    expect(listed(html)).toHaveLength(3);
+    expect(html).toContain("<strong>All</strong>");
+  });
+
+  it("Empty table: No items yet. on the default view", async () => {
+    await env.DB.prepare("DELETE FROM items").run();
+    expect(message(await (await get("/")).text())).toBe("No items yet.");
+  });
+
+  it("Nothing open: everything done, the open view says so", async () => {
+    await markDone(1, 2, 3);
+    const html = await (await get("/")).text();
+    expect(listed(html)).toEqual([]);
+    expect(message(html)).toBe("Nothing open.");
+  });
+
+  it("Nothing done: nothing done yet, the done view says so", async () => {
+    const html = await (await get("/?view=done")).text();
+    expect(listed(html)).toEqual([]);
+    expect(message(html)).toBe("Nothing done yet.");
+  });
+});
