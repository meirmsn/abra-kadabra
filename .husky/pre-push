# Run the unified pre-push guard suite. The .hooks/pre-push symlink points at
# /devshop/kit/hooks/pre-push.sh and is recreated by create-devshop-symlinks.sh
# (called from .husky/pre-commit) if lost. Repo detection happens inside the
# script — devshop-self mode skips main-block + PR-desc, runs only dirty-tree.
# Mirrors the .hooks/pre-commit wrapper pattern. See kit/docs/guide/hooks.md § 3.
[ ! -L .devshopkit ] && [ -d /devshop/kit ] && bash /devshop/kit/scripts/sync/create-devshop-symlinks.sh 2>/dev/null || true

if [ -x .hooks/pre-push ]; then
  exec bash .hooks/pre-push "$@"
fi
