# .env.example — Documents every key used in .devcontainer/.env.
#
# Copy to .env and fill in project-specific values during /ak-new-project setup.
# .env is gitignored and never committed (contains secrets).

# --- Container authentication ---
DEVCONTAINER_ROOT_PASSWORD=<pick-something>

# --- GitHub ---
GITHUB_TOKEN=<fine-grained-pat>

# --- Vercel ---
VERCEL_TOKEN=<personal-access-token>

# --- Supabase ---
# Prod URL for deploy workflows + Vercel env:
SUPABASE_PROD_URL=https://<project-ref>.supabase.co
# Local-stack default JWT (NOT the prod service-role key):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Account-wide personal access token:
SUPABASE_ACCESS_TOKEN=<personal-access-token>
# SUPABASE_DB_PASSWORD intentionally NOT here — paste from PW manager for ad-hoc use.

# --- AI ---
# QA key for edge function dev (NOT Claude Code's own key):
ANTHROPIC_API_KEY_QA=<api-key>

# --- Observability ---
SENTRY_DSN=https://<key>@o<org-id>.ingest.sentry.io/<project-id>
SENTRY_AUTH_TOKEN=<auth-token>
NEXT_PUBLIC_POSTHOG_KEY=<project-api-key>

# --- Notifications ---
NTFY_URL=https://ntfy.sh/<your-topic>

# --- Supabase ports (DERIVED — do not edit) ---
# These are overwritten on every container start by derive-ports-from-config.sh.
# To change ports, edit supabase/config.toml and rebuild the container.
# SUPABASE_API_PORT=54321
# SUPABASE_DB_PORT=54322
# SUPABASE_STUDIO_PORT=54323
# SUPABASE_MAILPIT_PORT=54324
# SUPABASE_ANALYTICS_PORT=54327
