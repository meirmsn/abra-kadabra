{
  "name": "MyProject",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:America/Los_Angeles}",
      "CLAUDE_CODE_VERSION": "latest",
      "GIT_DELTA_VERSION": "0.19.2",
      "SUPABASE_CLI_VERSION": "2.84.2",
      "DCG_VERSION": "0.4.0",
      "GITLEAKS_VERSION": "8.30.1"
    }
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    // Pipe project-runtime env vars from .devcontainer/.env into the container
    // (Supabase / Vercel tokens, optional ANTHROPIC_API_KEY_QA for projects whose
    // edge functions call Claude, etc.). Project-runtime ONLY — prod keys
    // (ANTHROPIC_API_KEY_PROD, prod service-role JWT) must never appear in
    // this file. See README.md § Getting started + your project's
    // /ak-new-project § Security Posture.
    "--env-file",
    "${localWorkspaceFolder}/.devcontainer/.env"
    // Here you can add "--memory=8g", "--cpus=4" for CPU/RAM limits for the container itself
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "EditorConfig.EditorConfig",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        // Trigger Prettier on save. Without it, Prettier is installed but does nothing automatically
        "editor.formatOnSave": true,
        // Without this VS Code will ask which formatter to use or use the wrong one, especially in TypeScript files where multiple formatters compete
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        // This is the only place ESLint auto-fix on save is configured. EditorConfig and Prettier don't cover this. Explicit means only when you explicitly save (not on auto-save, which triggers constantly as you type)
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        }
      }
    }
  },
  "remoteUser": "node",
  "mounts": [
    // Shell history survives container rebuilds (zsh/bash)
    "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    // Claude Code config, sessions, and API key survive container rebuilds
    "source=claude-code-config-${devcontainerId},target=/home/node/.claude,type=volume",
    "source=${localWorkspaceFolder}/../abra-kadabra,target=/devshop,type=bind,consistency=delegated",
    // Host docker socket — lets `supabase start` (which spawns its own
    // Postgres + GoTrue + Realtime + Edge Function containers) work from
    // inside this devcontainer. Why not the docker-in-docker feature: DiD
    // requires --privileged to actually function, otherwise the embedded
    // dockerd never starts and `docker info` reports "unavailable", which
    // historically silently routed /ak-pre-ship Gate 9 to admin-API-against-
    // hosted (i.e. polluting prod). Sharing the host socket is lighter and
    // works without --privileged. Containers that supabase spawns are
    // siblings of this devcontainer on the host engine, not nested.
    // The Dockerfile installs the docker CLI; the daemon is the host's.
    // See /devshop/kit/notes/roadmap/qa-options.md § Q1 option 1.
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "containerEnv": {
    // Heap size of node. Increased to handle claude code projects
    "NODE_OPTIONS": "--max-old-space-size=4096",
    // Store gstack artifacts inside the project so they survive container rebuilds and are version-trackable
    "GSTACK_STATE_DIR": "/workspace/.gstack",
    "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1",
    // Disable turbo telemetry — opt-out file lives in ~/.config outside the volume mount, so it'd reset on every rebuild otherwise
    "TURBO_TELEMETRY_DISABLED": "1",
    // Tell Playwright to use the apt-installed Chromium (see Dockerfile chromium block) instead of trying to download one from its CDN. Eliminates the firewall-stale-ipset problem entirely (DNS rotates faster than init-firewall.sh re-resolves).
    "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH": "/usr/bin/chromium"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  // Onboarding skipped since it hangs, plus not needed! (saves time by not having to go through it every time you start the container) - Happened when using Anthropic API Key
  "postCreateCommand": "echo '{\"hasCompletedOnboarding\": true}' > ~/.claude.json && pnpm install",
  // Configure git to use GITHUB_TOKEN via gh (skipped if token missing) - prevents having to sign in to github on container restart
  // init-docker-socket.sh aligns the in-container docker group's GID with the host socket's GID so `docker info` works without sudo.
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh && sudo /usr/local/bin/init-devshop.sh && sudo /usr/local/bin/init-docker-socket.sh && ([ -n \"$GITHUB_TOKEN\" ] && gh auth setup-git || true)",
  "waitFor": "postStartCommand"
}
