{
  "name": "MyProject",
  // Compose isolation: two-container compose. The workspace service
  // here has no docker access; the supabase-runner sibling holds the
  // docker socket and runs `supabase start` against the host engine.
  // See compose.yml comment block for the full architecture rationale,
  // and /devshop/kit/notes/security/local-supabase-isolation-options.md
  // for the threat model + decision matrix that motivated the swap.
  "dockerComposeFile": "compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspace",
  // Runs on the HOST before compose-up. Writes LOCAL_WORKSPACE_FOLDER
  // into .devcontainer/.env so compose can interpolate the supabase-
  // runner's host-path-mirrored bind. See init-host-env.sh for full
  // rationale; without this, compose-up fails with "path /supabase is
  // not shared from the host" because the bind interpolates to empty.
  "initializeCommand": [
    "bash",
    "${localWorkspaceFolder}/.devcontainer/init-host-env.sh",
    "${localWorkspaceFolder}"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "EditorConfig.EditorConfig",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        // Trigger Prettier on save. Without it, Prettier is installed but does nothing automatically
        "editor.formatOnSave": true,
        // Without this VS Code will ask which formatter to use or use the wrong one, especially in TypeScript files where multiple formatters compete
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        // This is the only place ESLint auto-fix on save is configured. EditorConfig and Prettier don't cover this. Explicit means only when you explicitly save (not on auto-save, which triggers constantly as you type)
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        }
      }
    }
  },
  "remoteUser": "node",
  // mounts here are additive to volumes declared on the workspace service
  // in compose.yml. Keep entries that need devcontainer-style interpolation
  // (${devcontainerId}, ${localWorkspaceFolder}) here; everything else
  // belongs in compose.yml.
  "mounts": [
    // Shell history survives container rebuilds (zsh/bash)
    "source=claude-code-bashhistory-${localWorkspaceFolderBasename},target=/commandhistory,type=volume",
    // Claude Code config, sessions, and API key survive container rebuilds
    "source=claude-code-config-${localWorkspaceFolderBasename},target=/home/node/.claude,type=volume",
    "source=${localWorkspaceFolder}/../abra-kadabra,target=/devshop,type=bind,consistency=delegated"
  ],
  "containerEnv": {
    // Heap size of node. Increased to handle claude code projects
    "NODE_OPTIONS": "--max-old-space-size=4096",
    // Store gstack artifacts inside the project so they survive container rebuilds and are version-trackable.
    // gstack has split-brain: CLI binaries (gstack-config) honor GSTACK_STATE_DIR; SKILL.md preamble bash
    // blocks honor GSTACK_HOME. Set both so projects/, sessions/, analytics/, learnings.jsonl all land in
    // /workspace/.gstack alongside config.yaml. The .gitignore filters out non-.md noise from version control.
    "GSTACK_STATE_DIR": "/workspace/.gstack",
    "GSTACK_HOME": "/workspace/.gstack",
    "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1",
    // Disable turbo telemetry — opt-out file lives in ~/.config outside the volume mount, so it'd reset on every rebuild otherwise
    "TURBO_TELEMETRY_DISABLED": "1",
    // Tell Playwright to use the apt-installed Chromium (see Dockerfile chromium block) instead of trying to download one from its CDN. Eliminates the firewall-stale-ipset problem entirely (DNS rotates faster than init-firewall.sh re-resolves).
    "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH": "/usr/bin/chromium"
  },
  // Onboarding skipped since it hangs, plus not needed! (saves time by not having to go through it every time you start the container) - Happened when using Anthropic API Key
  "postCreateCommand": "echo '{\"hasCompletedOnboarding\": true}' > ~/.claude.json && pnpm install",
  // Configure git to use GITHUB_TOKEN via gh (skipped if token missing) - prevents having to sign in to github on container restart.
  // No init-docker-socket.sh under compose isolation — the workspace has no docker
  // socket to align (the docker socket lives on supabase-runner only).
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh && sudo /usr/local/bin/init-devshop.sh && ([ -n \"$GITHUB_TOKEN\" ] && gh auth setup-git || true)",
  "waitFor": "postStartCommand"
}
