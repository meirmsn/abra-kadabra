.env

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
/build/
.next/
*.tsbuildinfo

# Turbo
.turbo/

# Next.js telemetry
**/cache/config.json

# Logs
*.log

.devshopkit
.claude/*
!.claude/memory/
.dcg.toml
.hooks/


# gstack runtime state — review artifacts under projects/ are version-tracked
# at any depth; transient state (browse logs, sessions, JSONL learnings, eval
# fingerprints) stays ignored. Four extensions cover every reviewable artifact
# type the skill audit surfaced: .md (design docs + ceo-plans), .html
# (design-shotgun + finalized HTML), .png (screenshots + variant previews),
# .json (approved.json + plan-eng outputs). The ** traversal handles deep
# subdirs like designs/<screen>-YYYYMMDD/ and tolerates branch-with-slash
# stray subdirs (fix/foo/*.md still matches). init-devshop.sh symlinks
# /home/node/.gstack/projects → /workspace/.gstack/projects so the five
# gstack skills that hardcode ~/.gstack/projects (canary, ship,
# land-and-deploy, plan-ceo-review, plan-design-review) also land here.
.gstack/*
!.gstack/projects/
.gstack/projects/**

# Re-include reviewable artifacts at any depth under projects/.
!.gstack/projects/**/
!.gstack/projects/**/*.md
!.gstack/projects/**/*.html
!.gstack/projects/**/*.png
!.gstack/projects/**/*.json

# OS
.DS_Store
.vercel

# Screenshots convention — /screenshots/ is for dev-context shots shared
# with Claude / the team. Folder contents are ignored; only the README is
# tracked so a fresh clone discovers the convention. Per-feature product
# shots still live in specs/<feature>/hero/ (tracked).
/screenshots/*
!/screenshots/README.md
# macOS drops screenshots at repo root by default — ignore those too.
/Screenshot*.png

# Pre-ship per-gate screenshot evidence — viewport/theme captures from the
# responsive gate, error/state captures from /qa, design-review diffs.
# Regenerable on every pre-ship run; not committed. Hero shots in
# specs/<feature>/hero/ ARE tracked. See kit/docs/guide/conventions.md
# § Screenshot Routing.
specs/*/screenshots/

# Pre-ship qa-walk artifacts — per-verb screenshots / state captures from
# Gate 9 proving each Core user story verb completed. Regenerable on every
# pre-ship run; not committed. See kit/docs/guide/workflow.md § Phase 1
# /ak-spec + pre-ship SKILL.md § Gate 9 § Core user story artifact assertion.
specs/*/qa-walk/

# Design-conformance artifacts — claims cache + per-run verification report
# produced by /ak-pre-ship's design-conformance gate. Regenerable; not committed.
# See kit/docs/guide/conventions.md and .claude/skills/devshop/design-conformance/SKILL.md.
specs/*/design-claims.json
specs/*/design-claims.json.sha256
specs/*/design-conformance-report.md

# Per-session handoff docs (transient, generated by /ak-handoff for context-continuation)
.handoff/
