.env

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
/build/
.next/
*.tsbuildinfo

# Turbo
.turbo/

# Next.js telemetry
**/cache/config.json

# Logs
*.log

.devshopkit
.claude/*
!.claude/memory/
.dcg.toml
.hooks/


# gstack runtime state (transient) — design docs, plans, and review history are version-tracked; logs/state are not
.gstack/browse.json
.gstack/browse-*.log

# OS
.DS_Store
.vercel

# Screenshots convention — /screenshots/ is for dev-context shots shared
# with Claude / the team. Folder contents are ignored; only the README is
# tracked so a fresh clone discovers the convention. Per-feature product
# shots still live in specs/<feature>/hero/ (tracked).
/screenshots/*
!/screenshots/README.md
# macOS drops screenshots at repo root by default — ignore those too.
/Screenshot*.png
