# Recreate tooling symlinks if missing (git ops can lose untracked symlinks).
# Uses the lightweight symlink-only script (no root needed).
[ ! -L .devshopkit ] && [ -d /devshop/kit ] && bash /devshop/kit/scripts/create-devshop-symlinks.sh 2>/dev/null || true

pnpm exec lint-staged
[ -f turbo.json ] && pnpm turbo run typecheck
gitleaks protect --staged --redact
if [ -x .hooks/pre-commit ]; then bash .hooks/pre-commit; fi
