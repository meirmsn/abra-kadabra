{
  "statusLine": {
    "type": "command",
    "command": "bash .devshop/scripts/statusline.sh"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(.claude/**)",
      "Read(.devshop/**)",
      "Edit(.claude/**)",
      "Edit(.devshop/**)",
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(turbo *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git mv *)",
      "Bash(git checkout*)",
      "Bash(git stash*)",
      "Bash(git branch*)",
      "Bash(git rm *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(docker ps*)",
      "Bash(docker images*)",
      "Bash(supabase gen types*)",
      "Bash(supabase status*)",
      "Bash(supabase migration list*)",
      "Bash(supabase start*)",
      "Bash(supabase stop*)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(git show*)",
      "Bash(echo *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(**/secrets*)",
      "Read(**/credentials*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/serviceAccountKey*.json)",
      "Read(**/gcp-credentials*.json)",
      "Read(**/*.xcconfig)",
      "Write(.env*)",
      "Write(**/.env*)",
      "Write(**/secrets*)",
      "Write(**/credentials*)",

      "Edit(**/.devcontainer/*)",
      "Write(**/.devcontainer/*)",
      "Edit(/devshop/.devcontainer/*)",
      "Write(/devshop/.devcontainer/*)",
      "Read(/devshop/.devcontainer/.env)",

      "Edit(**/.claude/settings.json)",
      "Write(**/.claude/settings.json)",
      "Edit(/devshop/.claude/settings.json)",
      "Write(/devshop/.claude/settings.json)",

      "Edit(**/.dcg.toml)",
      "Write(**/.dcg.toml)",
      "Edit(/devshop/.dcg.toml)",
      "Write(/devshop/.dcg.toml)",

      "Edit(.devshop/scripts/*)",
      "Write(.devshop/scripts/*)",
      "Edit(/devshop/.devshop/scripts/*)",
      "Write(/devshop/.devshop/scripts/*)"
    ],
    "additionalDirectories": ["/devshop"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "dcg"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .devshop/scripts/check-memory-created.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*commit*)",
            "command": "git remote get-url origin 2>/dev/null | grep -q 'abra-kadabra' && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":\"This commit was made in the devshop repo (abra-kadabra). Ask the user if they want to run release.sh to bump the version and update the changelog.\"}}' || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*commit*)",
            "command": "bash .devshop/scripts/check-dirty-after-commit.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git push*)",
            "command": "bash .devshop/scripts/check-pr-description.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash .devshop/scripts/session-start.sh"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash .devshop/scripts/session-start.sh"
          }
        ]
      }
    ]
  }
}
