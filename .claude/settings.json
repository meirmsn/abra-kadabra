{
  "statusLine": {
    "type": "command",
    "command": "bash /devshop/kit/scripts/statusline.sh"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(.claude/**)",
      "Edit(.claude/**)",
      "Read(kit/**)",
      "Edit(kit/**)",
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(turbo *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git mv *)",
      "Bash(git checkout*)",
      "Bash(git stash*)",
      "Bash(git branch*)",
      "Bash(git rm *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(docker ps*)",
      "Bash(docker images*)",
      "Bash(supabase gen types*)",
      "Bash(supabase status*)",
      "Bash(supabase migration list*)",
      "Bash(supabase start*)",
      "Bash(supabase stop*)",
      "Bash(find *)",
      "Bash(git show*)",
      "Bash(echo *)",
      "Bash(wc *)"
    ],
    "deny": [
      "Read(.env*)",
      "Write(.env*)",
      "Read(**/.env*)",
      "Write(**/.env*)",
      "Read(/devshop/.devcontainer/.env)",
      "Read(/workspace/.devcontainer/.env)",
      "Read(**/secrets*)",
      "Read(**/credentials*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/serviceAccountKey*.json)",
      "Read(**/gcp-credentials*.json)",
      "Read(**/*.xcconfig)",
      "Write(**/secrets*)",
      "Write(**/credentials*)",
      "Edit(**/.devcontainer/*)",
      "Write(**/.devcontainer/*)",
      "Edit(/devshop/.devcontainer/*)",
      "Write(/devshop/.devcontainer/*)",
      "Edit(**/.claude/settings.json)",
      "Write(**/.claude/settings.json)",
      "Edit(/devshop/.claude/settings.json)",
      "Write(/devshop/.claude/settings.json)",
      "Edit(**/.dcg.toml)",
      "Write(**/.dcg.toml)",
      "Edit(/devshop/.dcg.toml)",
      "Write(/devshop/.dcg.toml)",
      "Edit(.husky/pre-commit)",
      "Write(.husky/pre-commit)",
      "Edit(kit/scripts/*)",
      "Write(kit/scripts/*)",
      "Edit(/devshop/kit/scripts/*)",
      "Write(/devshop/kit/scripts/*)",
      "Edit(/devshop/template/**)",
      "Write(/devshop/template/**)",
      "Bash(cat * > *.claude/memory/*)",
      "Bash(cat * > *.claude/projects/*/memory/*)",
      "Bash(*> *.claude/memory/*)",
      "Bash(*> *.claude/projects/*/memory/*)",
      "Bash(*>>*.claude/memory/*)",
      "Bash(*>> *.claude/projects/*/memory/*)",
      "Bash(*tee *.claude/memory/*)",
      "Bash(*tee *.claude/projects/*/memory/*)"
    ],
    "additionalDirectories": ["/devshop"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "dcg"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*commit*)",
            "command": "bash /devshop/kit/scripts/check-hook-bypass.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*commit*)",
            "command": "bash /devshop/kit/scripts/check-branch-not-main.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /devshop/kit/scripts/check-memory-created.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*commit*)",
            "command": "if git remote get-url origin 2>/dev/null | grep -q 'abra-kadabra'; then _branch=$(git branch --show-current 2>/dev/null); if [ \"$_branch\" = \"main\" ]; then echo \"{\\\"hookSpecificOutput\\\":{\\\"hookEventName\\\":\\\"PostToolUse\\\",\\\"additionalContext\\\":\\\"This commit was made in the devshop repo (abra-kadabra). Ask the user if they want to run release.sh to bump the version and update the changelog.\\\"}}\"; else echo \"{\\\"hookSpecificOutput\\\":{\\\"hookEventName\\\":\\\"PostToolUse\\\",\\\"additionalContext\\\":\\\"This commit was made in the devshop repo (abra-kadabra) on branch $_branch. When the work is done: ask the user to confirm, then rebase onto main and release.\\\"}}\"; fi; fi"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*commit*)",
            "command": "bash /devshop/kit/scripts/check-dirty-after-commit.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git push*)",
            "command": "bash /devshop/kit/scripts/check-pr-description.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash /devshop/kit/scripts/session-start.sh"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash /devshop/kit/scripts/session-start.sh"
          }
        ]
      }
    ]
  }
}
