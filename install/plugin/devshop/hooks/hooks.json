{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x /opt/devshop-current/hooks/pre-bash.sh ]; then exec /opt/devshop-current/hooks/pre-bash.sh; fi",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x /opt/devshop-current/hooks/post-edit.sh ]; then exec /opt/devshop-current/hooks/post-edit.sh; fi"
          }
        ]
      }
    ]
  }
}
